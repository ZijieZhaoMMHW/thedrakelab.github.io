---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';
const all = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date);
const now = new Date();
const upcoming = all.filter((n) => n.data.type === 'event' && n.data.date >= now).reverse();
const past = all.filter((n) => !(n.data.type === 'event' && n.data.date >= now));
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="News">
  <h1>News &amp; events</h1>
  {upcoming.length > 0 && <>
    <h2>Upcoming events</h2>
    {upcoming.map((n) => (
      <div class="news-item"><span class="tag">event</span> <span class="muted">{fmt(n.data.date)}</span>
        <h3><a href={url(`news/${n.id}/`)}>{n.data.title}</a></h3></div>
    ))}
    <h2>News</h2>
  </>}
  {past.map((n) => (
    <div class="news-item"><span class="tag">{n.data.type}</span> <span class="muted">{fmt(n.data.date)}</span>
      <h3><a href={url(`news/${n.id}/`)}>{n.data.title}</a></h3></div>
  ))}
</Base>

---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { url } from '../lib/url';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('content/pages/home.md is missing');
const { Content } = await render(home);
const projects = (await getCollection('projects', (p) => p.data.status === 'active')).sort((a, b) => a.data.order - b.data.order);
const [latestPhoto, ...pastPhotos] = home.data.photos;
---
<Base>
  <h1>Lab mission</h1>
  <div class="prose lead"><Content /></div>
  {latestPhoto && <Media image={latestPhoto.src} caption={latestPhoto.caption} alt="Group photo" />}

  <h2>Current research areas</h2>
  <div class="grid grid-3 home-research">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>

  {pastPhotos.length > 0 && <>
    <h2>Previous group pictures</h2>
    {pastPhotos.map((ph) => <Media image={ph.src} caption={ph.caption} alt="Group photo" />)}
  </>}
</Base>

---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';
import { ROLE_LABELS, sortPeople } from '../lib/people';

const people = (await getCollection('people')).sort(sortPeople);
const current = people.filter((p) => p.data.status === 'current');
const pis = current.filter((p) => p.data.role === 'pi');
const members = current.filter((p) => p.data.role !== 'pi');
const alumni = people.filter((p) => p.data.status === 'alumni');
const years = (p: (typeof people)[number]) =>
  [p.data.start, p.data.end].some(Boolean) ? `${p.data.start?.slice(0, 4) ?? '?'}–${p.data.end?.slice(0, 4) ?? ''}` : '';
---
<Base title="People">
  <h1>People</h1>
  <h2>Current group members</h2>
  {pis.map((p) => <PersonCard person={p} wide />)}
  <div class="grid grid-people" style="margin-top:1.5rem">
    {members.map((p) => <PersonCard person={p} />)}
    <article class="card person">
      <div class="avatar" aria-hidden="true">?</div>
      <h3>You?</h3>
      <p class="bio">This avatar could be you—see the <a href={url('opportunities/')}>Opportunities page</a> for any currently available positions!</p>
    </article>
  </div>

  {alumni.length > 0 && <>
    <h2>Alumni</h2>
    <ul class="alumni-list">
      {alumni.map((p) => (
        <li>
          <strong>{p.data.website ? <a href={p.data.website}>{p.data.name}</a> : p.data.name}</strong>
          — {p.data.title ?? ROLE_LABELS[p.data.role]}{years(p) && <span class="muted"> ({years(p)})</span>}
          {p.data.next && <span>. Next: {p.data.next}</span>}
        </li>
      ))}
    </ul>
  </>}
</Base>

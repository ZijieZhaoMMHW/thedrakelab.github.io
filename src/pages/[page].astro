---
// Standalone pages from content/pages/*.md (except home.md, which is the Overview).
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('pages', (p) => p.id !== 'home')).map((p) => ({ params: { page: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// With `section_nav: true` in the front matter, link to each "## " section of the page.
const sections = entry.data.section_nav ? headings.filter((h) => h.depth === 2) : [];
---
<Base title={entry.data.title} description={entry.data.description ?? undefined}>
  <h1>{entry.data.title}</h1>
  {sections.length > 0 && (
    <nav class="section-nav" aria-label={`Sections of ${entry.data.title}`}>
      <span class="label">Jump to</span>
      {sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
  )}
  <div class:list={['prose', entry.data.section_nav && 'sectioned']}><Content /></div>
</Base>

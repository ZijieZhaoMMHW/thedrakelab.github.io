---
// Standalone pages from content/pages/*.md (except home.md, which is the Overview).
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('pages', (p) => p.id !== 'home')).map((p) => ({ params: { page: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description ?? undefined}>
  <h1>{entry.data.title}</h1>
  <div class="prose"><Content /></div>
</Base>
